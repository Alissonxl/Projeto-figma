{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["@figma/plugin-typings", "vitest/globals", "node"],
    "noEmit": true
  },
  "include": ["src", "tests", "scripts", "benchmarks", "vitest.config.ts"]
}
